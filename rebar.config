{cover_export_enabled, true}.
{cover_excl_mods, [
  shackle_client,
  shackle_protocol
]}.

{deps, [
  {foil, {git, "https://github.com/lpgauth/foil.git", {tag, "0.1.7"}}},
  {erlsem, {git, "https://github.com/x0id/erlsem.git", {tag, "0.7.0"}}},
  {metal, {git, "https://github.com/lpgauth/metal.git", {tag, "0.1.2"}}},
  {prometheus, "6.1.3"}
]}.

{dialyzer, [{plt_extra_apps, [public_key]}]}.

{edoc_opts, [
  {app_default, "http://www.erlang.org/doc/man"},
  {doclet, edown_doclet},
  {image, ""},
  {includes, ["include"]},
  {preprocess, true},
  {stylesheet, ""},
  {title, "shackle"}
]}.

{erl_opts, [
  debug_info,
  {platform_define, "^21.3|^22|^23|^24|^25|^26|^27|^28|^29", 'ATOMICS'},
  {platform_define, "^23|^24|^25|^26|^27|^28|^29", 'DECENTRALIZED_COUNTERS'},
  {platform_define, "^18|^19|^2", 'ETS_TAKE'},
  {platform_define, "^21|^22|^23|^24|^25|^26|^27|^28|^29", 'SSL_HANDSHAKE'}
]}.

{plugins,  [rebar3_hex, {rebar3_lint, "5.0.4"}, {rebar3_ex_doc, "0.3.0"}]}.
{hex,      [{doc, ex_doc}]}.

{ex_doc,   [
  {extras, [
    {"README.md", #{title => "Overview"}}
  ]},
  {main,       "README.md"},
  {source_url, "https://github.com/lpgauth/shackle"}
]}.

{profiles, [
  {bench, [
    {deps, [
      {timing,
        {git, "https://github.com/lpgauth/timing.git", {tag, "0.1.3"}}}
    ]},
    {extra_src_dirs, ["test"]}
  ]},
  {compile, [
    {erl_opts, [
      warnings_as_errors,
      warn_export_all,
      warn_export_vars,
      warn_missing_spec,
      warn_obsolete_guard,
      warn_shadow_vars,
      warn_untyped_record,
      warn_unused_import,
      warn_unused_vars
    ]}
  ]},
  {edoc, [
    {deps, [
      {edown,
        {git, "https://github.com/uwiger/edown.git", {tag, "0.9.2"}}}
    ]}
  ]},
  {profile, [
    {deps, [
      {fprofx,
        {git, "https://github.com/lpgauth/fprofx.git", {branch, "main"}}}
    ]},
    {extra_src_dirs, ["test"]}
  ]},
  {lint, [
    {deps, [
      {prometheus, "6.1.3"},
      {telemetry, "1.4.2"}
    ]},
    {dialyzer, [{plt_extra_apps, [public_key, prometheus, telemetry]}]}
  ]},
  {test, [
    {erl_opts, [{d, 'TEST'}]},
    {deps, [
      {meck, {git, "https://github.com/eproxus/meck.git", {tag, "v1.2.0"}}}
    ]}
  ]}
]}.

{xref_checks, [
  deprecated_functions,
  deprecated_function_calls,
  locals_not_used,
  undefined_function_calls
]}.
